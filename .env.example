# 필수 (운영 환경)
SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:postgresql://localhost:5432/haemi
DB_USERNAME=haemi
DB_PASSWORD=
# Generate with: openssl rand -base64 48
JWT_SECRET=
# Generate 32 bytes with: openssl rand -base64 32
ELDER_HEALTH_ENCRYPTION_KEY=

# 선택 (기관 관리자 가입 허용 이메일, 쉼표 구분 - 미설정 시 아무도 가입 불가)
# 가입 후에도 2FA 등록을 마쳐야 로그인할 수 있다.
INSTITUTION_ADMIN_EMAILS=

# 선택 (FCM 푸시 알림 - 미설정 시 발송 대신 로그만 남김)
# 서비스 계정 JSON 원문 또는 JSON 파일 경로.
# 운영 배포는 GitHub Secret의 JSON을 secrets/firebase-service-account.json 파일로 떨어뜨리고
# 이 값에는 컨테이너 안 경로(/run/secrets/firebase-service-account.json)를 넣는다.
FIREBASE_CREDENTIALS=
FIREBASE_PROJECT_ID=

# 선택 (Gemini 회상 카드 생성 - 미설정 시 안전한 기본 카드 사용)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# 선택 (로컬 Docker PostgreSQL 초기화용 - 외부 DB 사용 시 불필요)
POSTGRES_DB=haemi
POSTGRES_USER=haemi
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# 선택 (애플리케이션/OpenAPI 서버 주소)
APP_PORT=8080
OPENAPI_SERVER_URL=
