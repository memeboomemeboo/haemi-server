# 필수 (운영 환경)
SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:postgresql://localhost:5432/haemi
DB_USERNAME=haemi
DB_PASSWORD=
# Generate with: openssl rand -base64 48
JWT_SECRET=
# Generate 32 bytes with: openssl rand -base64 32
ELDER_HEALTH_ENCRYPTION_KEY=

# 선택 (Gemini 회상 카드 생성 - 미설정 시 안전한 기본 카드 사용)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# 선택 (로컬 Docker PostgreSQL 초기화용 - 외부 DB 사용 시 불필요)
POSTGRES_DB=haemi
POSTGRES_USER=haemi
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# 선택 (애플리케이션/OpenAPI 서버 주소)
APP_PORT=8080
OPENAPI_SERVER_URL=
